@{
    ViewBag.Title = "Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empleados = ViewBag.Empleados as System.Data.DataTable;
    var errorMessage = ViewBag.ErrorMessage as string;
}

<!DOCTYPE html>
<html>

<head>
    <title>@ViewBag.Title</title>
    <!-- Incluir CSS de Bootstrap si es necesario -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

    <!-- DataTables CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
</head>

<body>
    <ol class="breadcrumb mt-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
        <li class="breadcrumb-item active">Empleados</li>
    </ol>

    <script>
         function logout() {
    $.ajax({
        url: '@Url.Action("Logout", "Home")', // Ajusta el nombre del controlador si es diferente
        type: 'POST',
        success: function() {
            window.location.href = '@Url.Action("Index", "Iniciar_Sesion")'; // Redirige después del cierre de sesión
        },
        error: function(xhr, status, error) {
            console.error('Error durante el cierre de sesión:', error);
            // Opcional: maneja los errores aquí
        }
    });
}

    </script>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-users"></i> Lista De Empleados

        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                </div>
            </div>

            <hr />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            <table id="tabla" class="display cell-border" style="width: 100%">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>NoEmpleado</th>
                        <th>Departamento</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (empleados != null && empleados.Rows.Count > 0)
                    {
                        foreach (System.Data.DataRow row in empleados.Rows)
                        {
                            <tr>
                                <td>@row["Id"]</td>
                                <td>@row["Nombre"]</td>
                                <td>@row["NoEmpleado"]</td>
                                <td>@row["Departamento"]</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" onclick="openEditModal('@row["Id"]', '@row["Nombre"]', '@row["NoEmpleado"]', '@row["Departamento"]')">
                                        ✏ Editar
                                    </button>
                                    <button class="btn btn-danger btnEliminar" data-id="@row["Id"]" data-toggle="modal" data-target="#modalEliminar">
                                        <i class="fa fa-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">No se encontraron datos</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-center">
                            <button class="btn btn-success btn-sm" data-toggle="modal" data-target="#insertarEmpleadoModal">
                                ➕ Agregar Empleado
                            </button>
                        </td>
                    </tr>
                </tfoot>
            </table>

        </div>
    </div>


    <!-- Modal para editar empleado -->
    <div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">Editar Empleado</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="editForm" action="@Url.Action("EditarEmpleado", "Empleados")" method="post">
                        <input type="hidden" id="editId" name="Id" />
                        <div class="form-group">
                            <label for="editNombre">Nombre</label>
                            <input type="text" class="form-control" id="editNombre" name="Nombre" required />
                        </div>
                        <div class="form-group">
                            <label for="editNoEmpleado">NoEmpleado</label>
                            <input type="text" class="form-control" id="editNoEmpleado" name="NoEmpleado" required />
                        </div>
                        <div class="form-group">
                            <label for="editDepartamento">Departamento</label>
                            <input type="text" class="form-control" id="editDepartamento" name="Departamento" required />
                        </div>
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#tabla').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "language": {
                    "paginate": {
                        "next": "Siguiente",
                        "previous": "Anterior"
                    },
                    "search": "Buscar:",
                    "lengthMenu": "Mostrar _MENU_ registros",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    "infoEmpty": "No hay registros disponibles",
                    "infoFiltered": "(filtrado de _MAX_ registros en total)"
                }
            });
        });

        function openEditModal(id, nombre, noEmpleado, departamento) {
            $('#editId').val(id);
            $('#editNombre').val(nombre);
            $('#editNoEmpleado').val(noEmpleado);
            $('#editDepartamento').val(departamento);
            $('#editModal').modal('show');
        }
    </script>
    <div class="modal fade" id="insertarEmpleadoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar Nuevo Empleado</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="insertarEmpleadoForm">
                        <div class="form-group">
                            <label for="nombre">Nombre</label>
                            <input type="text" class="form-control" id="nombre" required>
                        </div>
                        <div class="form-group">
                            <label for="noEmpleado">No. Empleado</label>
                            <input type="text" class="form-control" id="noEmpleado" required>
                        </div>
                        <div class="form-group">
                            <label for="departamento">Departamento</label>
                            <input type="text" class="form-control" id="departamento" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $("#insertarEmpleadoForm").submit(function (event) {
                event.preventDefault();

                let nombre = $("#nombre").val();
                let noEmpleado = $("#noEmpleado").val();
                let departamento = $("#departamento").val();

                $.ajax({
                    url: "/Empleados/InsertarEmpleado",
                    type: "POST",
                    data: { Nombre: nombre, NoEmpleado: noEmpleado, Departamento: departamento },
                    success: function (response) {
                        alert("Empleado agregado correctamente");
                        location.reload();
                    },
                    error: function () {
                        alert("Error al agregar el empleado");
                    }
                });
            });
        });


    </script>


    <!-- Modal de Confirmación de Eliminación -->
    <div class="modal fade" id="modalEliminar" tabindex="-1" role="dialog" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEliminarLabel">Eliminar Empleado</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que deseas eliminar este empleado?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <script>
    $(document).ready(function () {
        var empleadoId; // Variable global para almacenar el ID del empleado

        // Captura el clic en el botón de eliminar
        $(".btnEliminar").click(function () {
            empleadoId = $(this).data("id"); // Obtiene el ID del empleado
        });

        // Confirmar eliminación
        $("#btnConfirmarEliminar").click(function () {
            $.ajax({
                url: '@Url.Action("EliminarEmpleado", "Empleados")',
                type: 'POST',
                data: { id: empleadoId },
                success: function (response) {
                    if (response.success) {
                        alert("Empleado eliminado correctamente.");
                        location.reload(); // Recargar la página
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function () {
                    alert("Ocurrió un error al intentar eliminar el empleado.");
                }
            });
        });
    });
    </script>


    <!-- Bootstrap JS y dependencias (si es necesario) -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>

</html>
