@{
    ViewBag.Title = "Home Page";
}

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">Dashboard</li>
</ol>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="row">
    <!-- Tarjeta para Total de Empleados -->
    <div class="col-xl-3 col-md-6">
        <div class="card bg-primary text-white mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Total De Empleados</h6>
                        <p id="totalEmpleados">Cargando...</p>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tarjeta para Calendario -->
    <div class="col-xl-3 col-md-6">
        <div class="card bg-danger text-white mb-4">
            <div class="card-body text-center">
                <div class="calendar-horizontal">
                    <i class="fas fa-calendar-alt fa-2x"></i>
                    <div class="date-info">
                        <span id="dayNumber" class="day-number"></span>
                        <span id="monthName" class="month-name"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Carrusel de imágenes -->
<div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="https://dealerimages.dealereprocess.com/image/upload/1042570.jpg" class="d-block w-100 carousel-img" alt="Imagen 1">
        </div>
        <div class="carousel-item">
            <img src="https://www.fmgbrakes.com/media/talleres-espa%C3%B1oles-reparar-coches.jpg" class="d-block w-100 carousel-img" alt="Imagen 2">
        </div>
        <div class="carousel-item">
            <img src="https://www.edenred.mx/hubfs/Media%20Source%202024%20%28im%C3%A1genes%20blog%29/Abril/Servicio-automotriz-que-debe-incluir-y-que-tipos-existen/servicio-automotriz-que-debe-incluir-y-que-tipos-existen.png" class="d-block w-100 carousel-img" alt="Imagen 3">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>

<script>
    $(document).ready(function() {
        $.ajax({
            url: '@Url.Action("TotalEmpleados", "Home")',
            type: 'GET',
            success: function(response) {
                $('#totalEmpleados').text(response.success ? response.totalEmpleados : 'Error: ' + response.message);
            },
            error: function(xhr, status, error) {
                $('#totalEmpleados').text('Error: ' + error);
            }
        });
    });

    function updateCalendar() {
        var today = new Date();
        $('#dayNumber').text(today.getDate());
        $('#monthName').text(today.toLocaleString('es-MX', { month: 'long' }));
    }
    updateCalendar();
</script>

<style>
    .card { border: 1px solid #ddd; border-radius: 0.5rem; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); margin-bottom: 1rem; }
    .card-header { background-color: #f8f9fa; padding: 1rem; border-bottom: 1px solid #ddd; font-weight: bold; }
    .card-body { padding: 1rem; }
    .calendar-horizontal { display: flex; align-items: center; justify-content: center; }
    .date-info { display: flex; align-items: baseline; margin-left: 10px; }
    .day-number { font-size: 1.5rem; font-weight: bold; margin-right: 5px; }
    .month-name { font-size: 1.2rem; }
    a.stretched-link { text-decoration: none; }
    
    /* Ajuste del tamaño de imágenes del carrusel */
    .carousel-img { height: 550px; object-fit: cover; }
</style>