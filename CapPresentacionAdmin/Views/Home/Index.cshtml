@{
    ViewBag.Title = "Home Page";
}

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">Dashboard</li>
</ol>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="row">
    <!-- Tarjeta para Total de Empleados -->
    <div class="col-xl-3 col-md-6">
        <div class="card bg-primary text-white mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Total De Empleados</h6>
                        <p id="totalEmpleados">Cargando...</p>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tarjeta para Calendario -->
    <div class="col-xl-3 col-md-6">
        <div class="card bg-danger text-white mb-4">
            <div class="card-body text-center">
                <div class="calendar-horizontal">
                    <i class="fas fa-calendar-alt fa-2x"></i>
                    <div class="date-info">
                        <span id="dayNumber" class="day-number"></span>
                        <span id="monthName" class="month-name"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-chart-area me-1"></i>
                Área Chart
            </div>
            <div class="card-body">
                <canvas id="myAreaChart" width="100%" height="40"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-chart-bar me-1"></i>
                Bar Chart
            </div>
            <div class="card-body">
                <canvas id="myBarChart" width="100%" height="40"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        $.ajax({
            url: '@Url.Action("TotalEmpleados", "Home")',
            type: 'GET',
            success: function(response) {
                $('#totalEmpleados').text(response.success ? response.totalEmpleados : 'Error: ' + response.message);
            },
            error: function(xhr, status, error) {
                $('#totalEmpleados').text('Error: ' + error);
            }
        });
    });

    function updateCalendar() {
        var today = new Date();
        $('#dayNumber').text(today.getDate());
        $('#monthName').text(today.toLocaleString('es-MX', { month: 'long' }));
    }
    updateCalendar();

    var chartConfig = (ctx, type, label, data, colors) => new Chart(ctx, {
        type: type,
        data: {
            labels: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
            datasets: [{ label, data, backgroundColor: colors, borderColor: colors.map(c => c.replace('0.2', '1')), borderWidth: 1 }]
        },
        options: { scales: { y: { beginAtZero: true } } }
    });

    chartConfig(document.getElementById('myAreaChart').getContext('2d'), 'line', 'Área Chart', [10, 20, 15, 25, 30, 35, 40, 45, 50, 55, 60, 65], ['rgba(75, 192, 192, 0.2)']);
    chartConfig(document.getElementById('myBarChart').getContext('2d'), 'bar', 'Bar Chart', [12, 19, 3, 5, 2, 3, 8, 15, 25, 10, 14, 18], ['rgba(255, 99, 132, 0.2)', 'rgba(54, 162, 235, 0.2)', 'rgba(255, 206, 86, 0.2)', 'rgba(75, 192, 192, 0.2)', 'rgba(153, 102, 255, 0.2)', 'rgba(255, 159, 64, 0.2)']);
</script>

<style>
    .card { border: 1px solid #ddd; border-radius: 0.5rem; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); margin-bottom: 1rem; }
    .card-header { background-color: #f8f9fa; padding: 1rem; border-bottom: 1px solid #ddd; font-weight: bold; }
    .card-body { padding: 1rem; }
    .calendar-horizontal { display: flex; align-items: center; justify-content: center; }
    .date-info { display: flex; align-items: baseline; margin-left: 10px; }
    .day-number { font-size: 1.5rem; font-weight: bold; margin-right: 5px; }
    .month-name { font-size: 1.2rem; }
    a.stretched-link { text-decoration: none; }
</style>
